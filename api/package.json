{
  "name": "quiz-api",
  "version": "1.0.0",
  "description": "API e servidor de partidas ao vivo do Quiz",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "migrar": "node db/migrar.js",
    "semear": "node scripts/semear.js",
    "test": "node --test tests/*.test.js",
