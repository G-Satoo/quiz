# Copie para .env e ajuste se precisar. O .env fica fora do git.

# ----- Postgres -----
DATABASE_URL=postgres://quiz:quiz123@localhost:5437/quiz
DATABASE_SSL=false

# ----- Redis -----
# Estado das salas ao vivo e pub/sub entre instâncias.
REDIS_URL=redis://localhost:6382

# ----- API -----
PORT=3003

# De onde o painel chama a API. Usado no CORS e na checagem de
# origem do WebSocket.
ORIGEM_PAINEL=http://localhost:5175

# ----- Sessão -----
COOKIE_SEGURO=false
SESSAO_TTL=604800
