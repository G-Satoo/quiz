# Copie para .env e ajuste se precisar. O .env fica fora do git.

# ----- Postgres -----
DATABASE_URL=postgres://quiz:quiz123@localhost:5437/quiz
DATABASE_SSL=false

# ----- Redis -----
# Estado das salas ao vivo e pub/sub entre instâncias.
REDIS_URL=redis://localhost:6382

# ----- API -----
PORT=3003

# De onde o painel chama a API. Usado no CORS e na checagem de
# origem do WebSocket.
ORIGEM_PAINEL=http://localhost:5175

# ----- Sessão -----
COOKIE_SEGURO=false
SESSAO_TTL=604800

# ----- Geração de perguntas por IA -----
# O provedor é trocável: o código fala um formato só, e quem muda
# é a configuração. "falso" não chama rede nenhuma — é o que os
# testes usam e serve para mexer na tela sem gastar cota.
#
#   falso   | gemini | openai-compativel (Groq, OpenRouter, Ollama...)
IA_PROVEDOR=falso

# A chave NUNCA vai para o .env.example nem para o git. Ela fica
# só no seu .env local, e a chamada acontece no SERVIDOR: se a
# chamada fosse do navegador, qualquer um leria a chave no
# inspetor e gastaria a sua cota.
IA_CHAVE=

# Vale para gemini e para openai-compativel.
IA_MODELO=gemini-3.6-flash

# Só para openai-compativel — o endereço do provedor.
# Ex.: https://api.groq.com/openai/v1
#      http://localhost:11434/v1   (Ollama rodando na sua máquina)
IA_URL_BASE=
